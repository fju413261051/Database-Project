-- 6. 座位 --------------------------------------------------------------------------------------------------------------
-- 示意用：第 1、2 車廂為標準車廂，第 6 車廂為商務車廂
-- 每個車廂 3 排 × A~E 共 15 個座位，合計 45 個
INSERT INTO seat (car_no, seat_no, car_type)
SELECT c.car_no,
       CAST(r.row_no AS varchar(2)) + l.letter,
       c.car_type
  FROM (VALUES (1, N'標準'), (2, N'標準'), (6, N'商務')) AS c(car_no, car_type)
 CROSS JOIN (VALUES (1), (2), (3)) AS r(row_no)
 CROSS JOIN (VALUES ('A'), ('B'), ('C'), ('D'), ('E')) AS l(letter)
 ORDER BY c.car_no, r.row_no, l.letter;

